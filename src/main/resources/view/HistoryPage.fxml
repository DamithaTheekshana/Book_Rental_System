<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="599.0" prefWidth="877.0" styleClass="background" stylesheets="@../StyleCSS/HistoryPage.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.HistoryPageFormController">
   <children>
      <Label layoutX="173.0" layoutY="44.0" text="Rental / Return Repotes" textFill="WHITE">
         <font>
            <Font name="Arial Black" size="41.0" />
         </font>
      </Label>
      <TableView fx:id="tblHistory" layoutX="60.0" layoutY="148.0" prefHeight="337.0" prefWidth="759.0">
        <columns>
          <TableColumn fx:id="colBookID" prefWidth="75.0" text="Book_ID" />
            <TableColumn fx:id="colCustID" prefWidth="75.0" text="Cust_ID" />
            <TableColumn fx:id="colRentalDate" prefWidth="107.0" text="Rental_Date" />
            <TableColumn fx:id="colDueDate" prefWidth="119.0" text="Due_Date" />
            <TableColumn fx:id="colQty" prefWidth="74.0" text="Qty" />
            <TableColumn fx:id="colReturnDate" prefWidth="105.0" text="Return_Date" />
            <TableColumn fx:id="colOverDays" prefWidth="106.0" text="Overdue_Days" />
            <TableColumn fx:id="colFineAmount" prefWidth="96.0" text="Fine Amount" />
        </columns>
      </TableView>
      <Button fx:id="btnClear" layoutX="375.0" layoutY="508.0" mnemonicParsing="false" onAction="#btnClearOnAction" prefHeight="45.0" prefWidth="129.0" styleClass="btnClear" stylesheets="@../StyleCSS/HistoryPage.css" text="Clear" textFill="#fc0606">
