            <Font name="Arial Black" size="15.0" />
         </font>
      </Label>
      <TextField fx:id="txtRentalID" layoutX="145.0" layoutY="120.0" />
      <TextField fx:id="txtBookID" layoutX="145.0" layoutY="174.0" />
      <Label layoutX="22.0" layoutY="175.0" prefHeight="23.0" prefWidth="149.0" text="Book ID        :">
         <font>
            <Font name="Arial Black" size="15.0" />
         </font>
      </Label>
      <TextField fx:id="txtCustID" layoutX="145.0" layoutY="227.0" />
      <Label layoutX="21.0" layoutY="228.0" prefHeight="19.0" prefWidth="142.0" text="Customer ID :">
         <font>
            <Font name="Arial Black" size="15.0" />
