      </Label>
      <Label layoutX="21.0" layoutY="278.0" prefHeight="19.0" prefWidth="142.0" text="Rental Date  :">
         <font>
            <Font name="Arial Black" size="15.0" />
         </font>
      </Label>
      <TextField fx:id="txtRentalDate" layoutX="146.0" layoutY="277.0" />
      <Label layoutX="21.0" layoutY="323.0" prefHeight="31.0" prefWidth="149.0" text="Due Date      :">
         <font>
            <Font name="Arial Black" size="15.0" />
         </font>
      </Label>
      <TextField fx:id="txtDueDate" layoutX="145.0" layoutY="326.0" />
      <Label layoutX="21.0" layoutY="408.0" prefHeight="31.0" prefWidth="142.0" text="Return Date :">
         <font>
            <Font name="Arial Black" size="15.0" />
