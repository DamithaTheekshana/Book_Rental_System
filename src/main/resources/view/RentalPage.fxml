      </Label>
      <TextField fx:id="txtReturnDate" layoutX="145.0" layoutY="411.0" />
      <TableView fx:id="tblRental" layoutX="309.0" layoutY="121.0" prefHeight="313.0" prefWidth="507.0">
        <columns>
          <TableColumn fx:id="colRentalID" prefWidth="75.0" text="Rental_ID" />
          <TableColumn fx:id="colBookID" prefWidth="84.0" text="Book_ID" />
            <TableColumn fx:id="colCustID" prefWidth="87.0" text="Customer_ID" />
            <TableColumn fx:id="colRentalDate" prefWidth="95.0" text="Rental_Date" />
            <TableColumn fx:id="colDueDate" prefWidth="99.0" text="Due_Date" />
            <TableColumn fx:id="colQty" prefWidth="66.0" text="Qty" />
        </columns>
      </TableView>
      <TextField fx:id="txtSearchbar" layoutX="566.0" layoutY="83.0" onAction="#txtSearchbarOnAction" prefHeight="25.0" prefWidth="209.0" promptText="Search rental..." styleClass="SearchBar" stylesheets="@../StyleCSS/BookPage.css" />
      <ImageView fx:id="imgIcon" fitHeight="25.0" fitWidth="24.0" layoutX="740.0" layoutY="84.0" onMouseClicked="#iconSearchOnAction" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../img/icons8-search-30.png" />
         </image>
      </ImageView>
      <Button fx:id="btnAdd" layoutX="106.0" layoutY="470.0" mnemonicParsing="false" onAction="#btnAddOnAction" prefHeight="25.0" prefWidth="77.0" styleClass="addBtn" stylesheets="@../StyleCSS/BookPage.css" text="ADD" textFill="#fffefe">
         <font>
            <Font name="Arial Black" size="12.0" />
         </font>
      </Button>
      <Button fx:id="btnDelete" layoutX="295.0" layoutY="470.0" mnemonicParsing="false" onAction="#btnDeleteOnAction" prefHeight="25.0" prefWidth="77.0" styleClass="deleteBtn" stylesheets="@../StyleCSS/BookPage.css" text="DELETE" textFill="WHITE">
         <font>
            <Font name="Arial Black" size="12.0" />
         </font>
      </Button>
      <Button fx:id="btnUpdate" layoutX="480.0" layoutY="470.0" mnemonicParsing="false" onAction="#btnUpdateOnAction" prefHeight="25.0" prefWidth="77.0" styleClass="updateBtn" stylesheets="@../StyleCSS/BookPage.css" text="UPDATE" textFill="WHITE">
