      <Button fx:id="btnReturn" layoutX="650.0" layoutY="470.0" mnemonicParsing="false" onAction="#btnReturnOnAction" prefHeight="25.0" prefWidth="77.0" styleClass="returnBtn" stylesheets="@../StyleCSS/RentalPage.css" text="RETURN" textFill="WHITE">
         <font>
            <Font name="Arial Black" size="12.0" />
         </font>
      </Button>
      <ImageView fitHeight="60.0" fitWidth="63.0" layoutX="27.0" layoutY="21.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../img/Systema Noleggio Libri.png" />
         </image>
      </ImageView>
      <Label layoutX="21.0" layoutY="363.0" prefHeight="31.0" prefWidth="149.0" text="Qty               :">
         <font>
            <Font name="Arial Black" size="15.0" />
         </font>
      </Label>
      <TextField fx:id="txtQty" layoutX="146.0" layoutY="366.0" />
